root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true

[*.{bat,cmd,sln}]
end_of_line = crlf

[*.{json,yaml,yml,xml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_trailing_comma_in_multiline_lists = true
csharp_trailing_comma_in_singleline_lists = false
resharper_arrange_trailing_comma_in_multiline_lists_highlighting = hint
